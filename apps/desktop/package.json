{
  "name": "@vmc/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "package": "electron-vite build && electron-builder --mac --publish never",
    "package:dir": "electron-vite build && electron-builder --mac --dir"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@tanstack/react-query": "^5.104.2",
    "@vmc/shared": "workspace:*",
    "motion": "^14.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4"
  },
  "description": "Elsewhere: work on a remote dev VM as if it were next to you",
  "author": "Eliezir",
  "homepage": "https://github.com/Eliezir/elsewhere"
}
