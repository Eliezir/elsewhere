{
  "machines": {
    "mac": {
      "ssh": null,
      "home": "~"
    },
    "pc": {
      "ssh": "adt-pc",
      "home": "~"
    }
  },
  "files": {
    "global/SHARED.md": {
      "dest": ".agents/SHARED.md",
      "to": [
        "mac",
        "pc"
      ]
    }
  },
  "skills": {
    "to": [
      "pc"
    ],
    "dest": ".claude/skills",
    "exclude": [
      ".env",
      "*.local",
      "node_modules",
      "synced"
    ]
  },
  "lines": [
    {
      "file": ".claude/CLAUDE.md",
      "line": "@~/.agents/SHARED.md",
      "to": [
        "mac",
        "pc"
      ]
    }
  ]
}
